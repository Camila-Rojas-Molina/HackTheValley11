# Copy to api/.env and fill in. Never commit .env files; keys go in with /env-key, never pasted in chat.
# Everything is optional for local work. The change-me-* placeholders are refused (treated as unset).

# Database. Local: a Postgres you run yourself (scripts/dev.sh). Tiger Cloud only after G1, with the
# connection options from the Tiger console (e.g. ?sslmode=require). DATABASE_URL is read when this is unset.
RB_DATABASE_URL=postgresql://postgres@localhost:5432/rainbowbone

# Admin routes (upload, runs, the outage drill) need X-Admin-Key. Unset = those routes answer 503.
RB_ADMIN_KEY=change-me-admin-key

# Files: analysis outputs the API serves (<RB_STORAGE_DIR>/<scan_id>/<name>; default <repo>/data/storage),
# and the shared large data outside the repo (full scans, weights) the worker reads from M5.
RB_STORAGE_DIR=
RB_DATA_DIR=
RB_MAX_UPLOAD_MB=600

# Analysis (C5): physics and segmentation timeouts, and the axial load on the vertebral body.
RB_SOLVE_TIMEOUT_S=120
RB_SEGMENT_TIMEOUT_S=900
RB_LOAD_N=800

# Browsers allowed by CORS (comma list). Default: the Next.js dev server only.
RB_CORS_ORIGINS=http://localhost:3000

# Database pool per API process (1-20). A free Tiger service allows 25 connections with no pooler.
RB_DB_POOL_MAX=8

# Start-up: apply api/migrations and seed the demo patient (both safe to repeat).
# Both refuse a database that is not on this machine unless RB_ALLOW_REMOTE_SCHEMA=1, which only the deploy
# sets, after G1 (Tiger Cloud gets no schema before then).
RB_AUTO_MIGRATE=1
RB_DEMO_SEED=1
RB_ALLOW_REMOTE_SCHEMA=0

# AI layer (contracts/ai-interface.md). Pinned to the template until M6 (Galit's gate): leave AI_CHAIN as is.
AI_CHAIN=template
AI_OFFLINE=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Vultr Serverless Inference: the subscription's inference key (Console > Serverless > Inference).
VULTR_API_KEY=
VULTR_BASE_URL=https://api.vultrinference.com/v1
VULTR_MODEL=qwen3.8-flash-next
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
