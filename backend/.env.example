# Copy to backend/.env and fill in. Never commit .env files.
# Everything except DATABASE_URL is optional: with no Telegram token the outbox
# writes messages to the log ("log" channel) and the app still runs.

# Postgres / Tiger Cloud (TimescaleDB). For Tiger, append the connection options
# from the Tiger console, e.g. ?sslmode=require
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/stillhere

# Telegram "Reminders" bot (from @BotFather). Leave empty to use the log channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Public URL of this server (tunnel or VM), used in invite links, QR codes,
# location links and the Telegram "Open live page" button (https only).
PUBLIC_BASE_URL=http://localhost:8000

# Operator endpoints (/v1/admin/*, /v1/demo/*) need X-Admin-Key. Unset = disabled.
# The change-me-* placeholders below are refused (treated as unset): set values of your own.
ADMIN_KEY=change-me-admin-key
# Seeds the demo device (Authorization: Bearer <DEVICE_KEY>, X-Device-Id: DEMO_DEVICE_ID).
DEVICE_KEY=change-me-device-key
DEMO_DEVICE_ID=scrunchie-1
# Seeds the demo wearer's /me key (Authorization: Bearer <WEARER_KEY>).
WEARER_KEY=change-me-wearer-key
DEMO_WEARER_NAME=Maya
# Demo PINs: the real PIN cancels; the duress PIN looks identical and sends a silent help request.
DEMO_PIN=
DEMO_DURESS_PIN=

# Signs contact live-page and location-link tokens and encrypts stored coordinates.
# If unset, a random secret is generated once and kept in the database.
APP_SECRET=

# demo (seconds) or real (minutes) timing profile for new sessions.
STILLHERE_PROFILE=demo
DISPLAY_TZ=America/Toronto

# Startup behaviour
AUTO_MIGRATE=1
DEMO_SEED=1
RUN_WORKERS=1

# Vultr Serverless Inference: words the PointClickCare care-team briefing only (never KAZE).
# The subscription's inference key (Console > Serverless > Inference), not the account API key.
# Empty = the deterministic template briefing.
VULTR_API_KEY=
VULTR_BASE_URL=https://api.vultrinference.com/v1
VULTR_MODEL=qwen3.8-flash-next

# Vultr Compute VM (docker compose --profile vultr): Caddy gets an HTTPS certificate for this
# name, e.g. stillhere.203-0-113-7.nip.io; set PUBLIC_BASE_URL=https://<the same name>.
PUBLIC_HOSTNAME=

# Heart-rate bridges on the demo laptop (scripts/hr_bleak.py, scripts/hr_pulsoid.py). They post to
# STILLHERE_URL with WEARER_KEY. HR_DEVICE pins the phone (the macOS UUID the bleak bridge prints).
# PULSOID_TOKEN needs the data:heart_rate:read scope; set it with /env-key, never paste it in chat.
STILLHERE_URL=http://localhost:8000
HR_DEVICE=
PULSOID_TOKEN=
