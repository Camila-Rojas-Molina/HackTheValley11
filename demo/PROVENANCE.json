{
  "schema": "rb.demo-provenance/1",
  "about": "Every file in demo/ except this one: its sha256 and size, the script that made it, whether it is measured or mock, and its provenance (contracts/formats.md, Demo bundle). Paths are relative to demo/. Scripts and source files live in RB_DATA_DIR, outside the repo; each demo file is a byte-for-byte copy of its source. pipeline/tests/test_demo_bundle.py checks this file.",
  "status_line": "Research prototype on public, de-identified data. Not a medical device. Not for clinical use or diagnosis.",
  "attribution": "ATTRIBUTION.md",
  "scripts": {
    "RB_DATA_DIR/spikes/data-scripts/crop.py": {
      "what": "Crops one level from the full-scan NIfTIs: the level's vertebra label plus a 10 mm margin, resampled to 1.0 mm isotropic (CT linear, masks nearest-neighbour). The lesion mask is the dataset lesion map restricted to the vertebra mask.",
      "command": "crop.py <dir holding ct_, vertebrae_ and lesions_ NIfTIs of one scan> <scan date> 20 L1",
      "upstream": [
        "CT DICOM to NIfTI with SimpleITK (RB_DATA_DIR/spikes/data-scripts/ctnii.py; seg1.py writes the same file)",
        "DICOM-SEG to label maps on the CT grid, highdicom combine_segments=True, resampled by physical coordinates with nearest-neighbour (RB_DATA_DIR/spikes/data-scripts/seg2.py)"
      ],
      "sha256": "2843c151d945eb12d75990ae8ec1ab16cfb2fb9ebd163a45ebdf9bb03a2f3912",
      "bytes": 1815
    },
    "RB_DATA_DIR/demo-src/phantom/gen_data.py": {
      "what": "Synthetic femur-shaft phantom for the viewer spike: a tube with a cortical shell, marrow and a spherical lytic defect, Gaussian noise with seed 0. No third-party data.",
      "command": "gen_data.py <out_dir>",
      "upstream": [],
      "sha256": "0044d76399ee51cfe4b106fc985a1724611ad721abb7ccc9dacdc8c2c76e684b",
      "bytes": 3514
    },
    "RB_DATA_DIR/demo-src/phantom/gen_mock_strain.py": {
      "what": "MOCK strain field for the phantom: a fixed analytic formula (base level, side-to-side gradient, bump at the defect), not a finite-element result. Volume on the phantom CT grid; surface = the phantom's bone.mz3 mesh with the formula's values per vertex.",
      "command": "gen_mock_strain.py RB_DATA_DIR/demo-src/phantom/ct.nii.gz RB_DATA_DIR/demo-src/phantom/bone.mz3 <out_dir>",
      "upstream": [
        "RB_DATA_DIR/demo-src/phantom/gen_data.py"
      ],
      "sha256": "c10aeafec9ceeefb80ed4e10de932ca0eda9d9f95d049a1c91fb1a84f9f1e711",
      "bytes": 3782
    }
  },
